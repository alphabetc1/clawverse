# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
*.tsbuildinfo

# TypeScript generated files (should only be in dist/, but exclude if generated elsewhere)
*.d.ts
*.d.ts.map
*.js.map
# Keep .js files in src/ that are intentional (none expected, but be safe)
# If you have hand-written .js files, add them to git with -f

# Lock files - this project uses pnpm
package-lock.json
yarn.lock

# Environment and secrets
.env
.env.local
.env.*.local
.env.production
.env.development
*.pem
*.key
*.p12
*.pfx


{
  "name": "clawverse",
  "version": "0.1.0",
  "description": "Centralized control plane for managing multiple OpenClaw instances",
  "private": true,
  "type": "module",
  "bin": {
    "clawverse": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js daemon start",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "clawverse": "node dist/cli/index.js"
  },
  "keywords": [
    "openclaw",
    "ai",
    "assistant",
    "multi-instance",
    "orchestration"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.23.0",
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "commander": "^13.1.0",
    "express": "^5.0.1",
    "json5": "^2.2.3",
    "nanoid": "^5.0.9",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.17",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.2"
  }
}

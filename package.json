{
  "name": "clawverse",
  "version": "0.1.0",
  "description": "Centralized control plane for managing multiple OpenClaw instances",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @clawverse/hub dev",
    "start": "pnpm --filter @clawverse/hub start",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "clawverse": "node packages/cli/dist/index.js"
  },
  "keywords": [
    "openclaw",
    "ai",
    "assistant",
    "multi-instance",
    "orchestration"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.23.0"
}
